<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to secrets.config (same folder) and fill in real values.
  If secrets.config is missing or the values are empty, the app uses the SQLite database instead of Oracle.
-->
<appSettings>
  <add key="ORACLE_USER" value="" />
  <add key="ORACLE_PASSWORD" value="" />
</appSettings>
