<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="bills_project.SiteMaster" %>

<!DOCTYPE html>

<html lang="en" data-bs-theme="light">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BillLens · Bill processing with OCR</title>
    <webopt:bundlereference runat="server" path="~/Content/css" />
    <%-- Font Awesome icons (linked directly so its relative ../webfonts paths resolve) --%>
    <link href="~/Content/css/all.min.css" rel="stylesheet" />
    <link href="~/Content/images/logo.svg" rel="icon" type="image/svg+xml" />
</head>
<body class="d-flex flex-column min-vh-100">
    <form runat="server" class="d-flex flex-column flex-grow-1">
        <asp:ScriptManager runat="server" EnableCdn="false">
            <Scripts>
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
            </Scripts>
        </asp:ScriptManager>

        <asp:PlaceHolder ID="phNav" runat="server" Visible="false">
            <nav class="navbar navbar-expand-lg app-navbar" data-bs-theme="dark" aria-label="Main navigation">
                <div class="container">
                    <a class="navbar-brand d-flex align-items-center gap-2" href="<%: ResolveUrl("~/Pages/Home/HomeOptions.aspx") %>">
                        <img src="<%: ResolveUrl("~/Content/images/logo.svg") %>" alt="" width="32" height="32" />
                        <span class="fw-semibold">BillLens</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><asp:HyperLink ID="lnkHome" runat="server" CssClass="nav-link" NavigateUrl="~/Pages/Home/HomeOptions.aspx"><i class="fas fa-house me-1"></i>Home</asp:HyperLink></li>
                            <li class="nav-item"><asp:HyperLink ID="lnkUpload" runat="server" CssClass="nav-link" NavigateUrl="~/Pages/Upload/UploadBill.aspx"><i class="fas fa-file-arrow-up me-1"></i>Upload</asp:HyperLink></li>
                            <li class="nav-item"><asp:HyperLink ID="lnkManual" runat="server" CssClass="nav-link" NavigateUrl="~/Pages/ManualEntry/ManualEntry.aspx"><i class="fas fa-keyboard me-1"></i>Manual entry</asp:HyperLink></li>
                            <li class="nav-item"><asp:HyperLink ID="lnkBills" runat="server" CssClass="nav-link" NavigateUrl="~/Pages/View/ViewBills.aspx"><i class="fas fa-receipt me-1"></i>My bills</asp:HyperLink></li>
                            <li class="nav-item"><asp:HyperLink ID="lnkAudit" runat="server" CssClass="nav-link" NavigateUrl="~/Pages/Audit/AuditLog.aspx" Visible="false"><i class="fas fa-clipboard-list me-1"></i>Audit log</asp:HyperLink></li>
                        </ul>
                        <span class="navbar-text me-3">
                            <i class="fas fa-circle-user me-1"></i><asp:Literal ID="litUserName" runat="server" />
                            <asp:Label ID="lblAdminBadge" runat="server" CssClass="badge text-bg-warning ms-1" Visible="false" Text="Admin" />
                        </span>
                        <asp:HyperLink ID="lnkLogout" runat="server" CssClass="btn btn-outline-light btn-sm" NavigateUrl="~/Pages/Login/Logout.aspx"><i class="fas fa-right-from-bracket me-1"></i>Log out</asp:HyperLink>
                    </div>
                </div>
            </nav>
        </asp:PlaceHolder>

        <main class="container py-4 flex-grow-1">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <footer class="border-top py-3 text-muted small">
            <div class="container d-flex justify-content-between">
                <span>BillLens &middot; bill processing with OCR</span>
                <span>&copy; <%: DateTime.Now.Year %></span>
            </div>
        </footer>
    </form>
    <script src="<%: ResolveUrl("~/Scripts/lib/bootstrap.bundle.min.js") %>"></script>
</body>
</html>
