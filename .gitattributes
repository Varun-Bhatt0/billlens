# Normalise line endings in the repository; check out with the platform default
* text=auto

*.cs      text diff=csharp
*.aspx    text
*.master  text
*.config  text
*.csproj  text
*.sln     text eol=crlf
*.ps1     text eol=crlf
*.sh      text eol=lf
*.yml     text eol=lf

*.png     binary
*.jpg     binary
*.ico     binary
*.woff2   binary
*.ttf     binary
*.dll     binary
*.db      binary
